<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.7.0</Version>
    <AssemblyName>KademeliEgitimPlatformu</AssemblyName>
    <RootNamespace>KademeliEgitimPlatformu</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test ve geliştirici araçları ayrı derlenir; ana uygulamaya dahil edilmez. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Öğrenci bilgisayarlarına düz metin soru dosyası kopyalanmaz.
         Yayın çıktısında yalnızca AES-256-GCM ile şifrelenmiş Sorular.dat bulunur. -->
    <None Update="Data\Sorular.dat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\Sorular.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>