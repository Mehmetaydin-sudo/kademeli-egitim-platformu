<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.8.2</Version>
    <AssemblyName>KademeliEgitimPlatformu</AssemblyName>
    <RootNamespace>KademeliEgitimPlatformu</RootNamespace>
    <Product>Kademeli Eğitim Platformu</Product>
    <Title>Kademeli Eğitim Platformu</Title>
    <AssemblyTitle>Kademeli Eğitim Platformu</AssemblyTitle>
    <Description>Öğretmen ve öğrencilerin her alan için kendi sorularını (.docx, .pdf, .xlsx, .csv) yükleyebildiği, kademeli zorluk seviyeleri ve pedagojik açıklamalarla %100 çevrimdışı çalışan masaüstü eğitim ve sınav platformu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test ve geliştirici araçları ayrı derlenir; ana uygulamaya dahil edilmez. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="database\schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
